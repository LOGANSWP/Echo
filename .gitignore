# OpenCode agent runtime data
.omo/
# Personal model/provider routing (user-specific, not shared)
.opencode/oh-my-openagent.json

# Codex project configuration is shared; local runtime files stay ignored.
.codex/*
!.codex/config.toml
.codegraph/

# Xcode
*.xcuserdata
*.xcworkspace/xcuserdata/
DerivedData/
*.xcresult
*.xcbkptlist

# Swift Package Manager
.build/
Packages/
*.xcodeproj/xcshareddata/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# ==========================================
# Model Files (large binaries, fetched via Scripts/prepare_models.sh)
# ==========================================
# Production bundle models (in Echo/Resources/Models/)
Echo/Resources/Models/*.mlmodelc/
Echo/Resources/Models/*.mlpackage/
Echo/Resources/Models/*.gguf
Echo/Resources/Models/*.aimodel/
# tokenizer.json is a TEXT vocabulary (not a model binary) required by E5
# inference at runtime (E5Embedder loads it from Bundle.main) — committed.
Echo/Resources/Models/*.safetensors
Echo/Resources/Models/**/*.safetensors
Echo/Resources/Models/OfflineGeneration.bundle/
# Keep .gitkeep to preserve directory structure
!Echo/Resources/Models/.gitkeep


# Build artifacts
*.ipa
*.dSYM.zip
*.dSYM
buildServer.json
compile_commands.json

# Pinned model conversion sources (fetched via prepare_models.sh; not committed)
PinnedModels/

# Debug-only real-model simulator derivative; rebuilt from pinned local artifacts.
Echo/Resources/Models/OfflineGenerationSimulator.bundle/

# Local Python interpreter caches.
__pycache__/
*.pyc
